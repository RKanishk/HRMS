NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://cipl:cipl_local_only@localhost:5432/cipl_hrms?schema=public
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COMPANY_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
# Generate a fresh key with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
STORAGE_PATH=./storage
# Development email adapter writes private .eml files locally; use smtp in production.
EMAIL_DRIVER=local
EMAIL_FROM=hrms@cipl.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TRUST_PROXY=0
AUTH_RATE_LIMIT=10
POSTGRES_USER=cipl
POSTGRES_PASSWORD=cipl_local_only
POSTGRES_DB=cipl_hrms
